#!/bin/sh

### BEGIN INIT INFO
# Provides:          mambocollector
# Required-Start:    $local_fs $network $remote_fs
# Required-Stop:     $local_fs $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MySQL StatsD data collector
### END INIT INFO

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
DESC="MySQL StatsD data collector"
PYTHON=/opt/mambocollector/venv/bin/python3
COLLECTOR=/opt/mambocollector/mambocollector.py
SERVICE_USER=mambocollector
PIDFILE=/run/mambocollector.pid

# Keep deployment paths in this root-owned script.
export MAMBOCFG=/etc/mambo/config.cnf
export MAMBOCMD=/etc/mambo/commands.cnf
export MAMBOLOG=/var/log/mambocollector/collector.log
export MAMBODBG=0

. /lib/lsb/init-functions

start_collector() {
    if [ ! -x "$PYTHON" ] || [ ! -r "$COLLECTOR" ]; then
        log_failure_msg "Cannot find collector or Python environment under /opt/mambocollector"
        return 1
    fi
    runuser -u "$SERVICE_USER" -- "$PYTHON" -I "$COLLECTOR" check || return "$?"
    start-stop-daemon --start --quiet --oknodo --background --make-pidfile \
        --pidfile "$PIDFILE" --user "$SERVICE_USER" --chuid "$SERVICE_USER" \
        --startas "$PYTHON" -- -I "$COLLECTOR" run
}

stop_collector() {
    start-stop-daemon --stop --quiet --oknodo --retry TERM/10/KILL/5 \
        --pidfile "$PIDFILE" --user "$SERVICE_USER" --remove-pidfile
}

case "${1:-}" in
    start)
        log_daemon_msg "Starting $DESC"
        start_collector
        ;;
    stop)
        log_daemon_msg "Stopping $DESC"
        stop_collector
        ;;
    restart)
        log_daemon_msg "Restarting $DESC"
        stop_collector && start_collector
        ;;
    status)
        start-stop-daemon --status --pidfile "$PIDFILE" --user "$SERVICE_USER"
        exit "$?"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 2
        ;;
esac

result=$?
log_end_msg "$result"
exit "$result"
